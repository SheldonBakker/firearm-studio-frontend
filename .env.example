# Copy to .env and fill in real values. (.env is read by Vite at build time;
# everything VITE_* is inlined into the client bundle.)

# Supabase project credentials (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shared API key sent as the X-Api-Key header on every /api request, alongside
# the per-user Supabase JWT. Required by the backend.
VITE_API_KEY=your-shared-api-key

# Leave empty so the app calls same-origin /api/* and the Worker (workers/app.ts)
# proxies it to API_BASE_URL — avoids CORS. Set to an absolute API URL only if
# you want the browser to call the API directly.
VITE_API_BASE_URL=

# --- Worker-side (NOT a VITE_ var) ---
# The /api proxy target is configured for the Worker via .dev.vars in dev
# (API_BASE_URL=...) and wrangler.jsonc `vars` in production.
