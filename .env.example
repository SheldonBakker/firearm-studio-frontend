# Copy to .env and fill in real values.
# Supabase project credentials (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave empty in dev so the app calls same-origin /api and Vite proxies it
# (avoids CORS). Set to the absolute API URL for production builds.
VITE_API_BASE_URL=

# Dev only: where the Vite proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:5146
