{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firearm-studio-frontend",
  "compatibility_date": "2026-06-28",
  "main": "workers/app.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_BASE_URL": "https://api.firearmstudio.com"
  }
}
